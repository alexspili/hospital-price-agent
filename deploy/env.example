# Copy to .env next to docker-compose.yml on the server. Never commit the filled-in copy.
HPA_DOMAIN=prices.alexspi.com
HPA_DATA_DIR=/mnt/hpa

# The PIN you share with the people you want to be able to run a live scan.
HPA_LIVE_PIN=

# Limits for a public deployment. Live runs per IP per hour, price files one run may
# download, and the daily budget for model calls in US dollars.
HPA_RUNS_PER_HOUR=4
HPA_MAX_DOWNLOADS=3
HPA_DAILY_CAP_USD=2

# Optional: without it the deterministic pipeline still runs, minus the three fallbacks.
ANTHROPIC_API_KEY=
